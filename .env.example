# Copy to .env and adjust. All variables are optional; CLI flags override them.

# Directory the server is confined to (default: current working directory).
LTMCP_ROOT=/path/to/your/repo

# Transport: "stdio" (local clients) or "http" (ChatGPT via a tunnel).
LTMCP_TRANSPORT=stdio

# HTTP bind address (only used when LTMCP_TRANSPORT=http).
LTMCP_HOST=127.0.0.1
LTMCP_PORT=8000

# Bearer token REQUIRED for http transport. Generate with: openssl rand -hex 24
LTMCP_AUTH_TOKEN=

# Optional: restrict the Host header to your tunnel hostname (defense in depth).
# LTMCP_ALLOWED_HOSTS=mcp.yourdomain.com,your-subdomain.ngrok-free.app

# Comma-separated allowlist of programs (default: a read-only inspection set).
# LTMCP_ALLOW_COMMANDS=git,rg,grep,ls,cat,head,tail,wc,find,tree,stat,file,pwd,echo,diff

# Enable the write_file tool (default: false).
LTMCP_ALLOW_WRITE=false

# Output truncation limit (bytes) and per-command timeout (seconds).
LTMCP_MAX_OUTPUT_BYTES=100000
LTMCP_TIMEOUT=120
