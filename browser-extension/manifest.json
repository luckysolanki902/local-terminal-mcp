{
  "manifest_version": 3,
  "name": "ChatGPT → Local MCP Image Saver",
  "version": "0.1.0",
  "description": "Save ChatGPT-generated images straight into your local repo via local-terminal-mcp.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.luckytunnel.in/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MCP Image Saver"
  }
}
